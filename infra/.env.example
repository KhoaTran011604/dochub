# Copy thành infra/.env rồi điền. KHÔNG commit infra/.env.
# Sinh secret: openssl rand -hex 32
# Mật khẩu database nằm trong connection URL → chỉ dùng ký tự hex/chữ số
# (không @ : / ? # % $).
# Giá trị có ký tự `$` hoặc JSON: bọc trong nháy đơn '...' để compose không nội suy.

# ───────────── Postgres ─────────────
# Superuser `postgres`: chỉ dùng cho init và backup.
POSTGRES_PASSWORD=
# Role `outline` (owner database `outline`).
OUTLINE_DB_PASSWORD=
# Role `hd_document_apps`: owner database `hd_document_apps` (schema bridge,
# permission_api). Chỉ dùng để chạy migration.
APP_DB_PASSWORD=
# Role runtime của từng service (quyền theo bảng, cấp trong migration).
BRIDGE_DB_PASSWORD=
PERMISSION_API_DB_PASSWORD=
# Port Postgres trên host (127.0.0.1). Host đã có Postgres chiếm 5432 thì đổi, ví dụ 55432.
POSTGRES_HOST_PORT=5432

# ───────────── Outline ─────────────
# URL người dùng gõ trên trình duyệt (qua reverse proxy thì là URL của proxy).
OUTLINE_URL=http://localhost:3000
OUTLINE_HOST_PORT=3000
# Địa chỉ host mà Outline nghe. Mặc định chỉ loopback; đặt 0.0.0.0 để máy khác
# trong mạng vào thẳng (HTTP không mã hóa — chỉ nên dùng khi dev).
OUTLINE_BIND_ADDRESS=127.0.0.1
# openssl rand -hex 32 (bắt buộc đúng 32 byte hex)
OUTLINE_SECRET_KEY=
# openssl rand -hex 32
OUTLINE_UTILS_SECRET=
# true khi chạy sau reverse proxy có TLS.
OUTLINE_FORCE_HTTPS=false
# Số request tối đa mỗi phút cho 1 IP (tính cả file tĩnh); quá thì Outline trả 429.
# Sau reverse proxy mọi user chung 1 IP → nâng lên. Dev chạy E2E liên tiếp: 10000.
OUTLINE_RATE_LIMITER_REQUESTS=1000
# Ngôn ngữ UI mặc định. Không chắc "vi_VN" có trong danh sách của tag 1.10.1 thì
# giữ "en_US" (xem phase-03, bảng giả định).
DEFAULT_LANGUAGE=en_US
# Tắt đăng ký OAuth client động qua /oauth/register; client cho permission API
# (phase 5) chỉ tạo bằng script register-outline-oauth-client.
OAUTH_DISABLE_DCR=true

# ───────────── Outline ↔ oidc-bridge (OIDC) ─────────────
# Bridge nghe port 4001 (4000 là erp-fake). Auth/logout: trình duyệt gọi → URL
# public của bridge; token/userinfo: container Outline gọi → tên service trong
# mạng compose. Khai tay, không dùng discovery.
OIDC_CLIENT_ID=outline
# openssl rand -hex 32 (Outline và bridge dùng chung)
OIDC_CLIENT_SECRET=
OIDC_AUTH_URI=http://localhost:4001/auth
OIDC_TOKEN_URI=http://oidc-bridge:4001/token
OIDC_USERINFO_URI=http://oidc-bridge:4001/me
OIDC_LOGOUT_URI=http://localhost:4001/session/end
OIDC_DISPLAY_NAME=HD ERP
# Claim userinfo Outline dùng làm username hiển thị.
OIDC_USERNAME_CLAIM=preferred_username
OIDC_SCOPES=openid profile email

# ───────────── oidc-bridge ─────────────
# URL trình duyệt dùng để vào bridge (cũng là issuer). Phải khớp host của OIDC_AUTH_URI.
BRIDGE_PUBLIC_URL=http://localhost:4001
BRIDGE_HOST_PORT=4001
BRIDGE_BIND_ADDRESS=127.0.0.1
# true khi bridge chạy sau reverse proxy (tin X-Forwarded-For/Proto).
BRIDGE_TRUST_PROXY=false
# Khóa ký cookie: openssl rand -hex 32. Xoay khóa: thêm khóa mới lên ĐẦU, cách nhau dấu phẩy.
BRIDGE_COOKIE_KEYS=
# Khóa ký id_token. Sinh 1 lần rồi giữ nguyên:
#   pnpm --filter @hd-document/oidc-bridge generate:signing-jwks
# (lệnh in sẵn cả dòng BRIDGE_SIGNING_JWKS='{...}')
BRIDGE_SIGNING_JWKS=

# Tài khoản quản trị local (đường admin / break-glass khi không có ERP).
SYSTEM_ADMIN_USERNAME=system_admin_dochub
# Trùng email của admin Outline có sẵn thì đăng nhập sẽ vào chính account đó.
SYSTEM_ADMIN_EMAIL=
SYSTEM_ADMIN_DISPLAY_NAME=System Admin
# Hash argon2id của mật khẩu (≥ 16 ký tự, dài ngẫu nhiên):
#   printf '%s' '<mật khẩu>' | pnpm --filter @hd-document/oidc-bridge generate:admin-password-hash
# (lệnh in sẵn cả dòng SYSTEM_ADMIN_PASSWORD_HASH='$argon2id$...') system_admin_dochub
SYSTEM_ADMIN_PASSWORD_HASH=

# ───────────── IdP thật (OIDC, idp.hdwebsoft.co) ─────────────
# User không có handoff được bridge chuyển sang IdP đăng nhập (authorization
# code + PKCE). Đăng ký ở IdP cho client này: Redirect URI
# = <BRIDGE_PUBLIC_URL>/upstream/callback (dev: http://localhost:4001/upstream/callback),
# Consent Type = Implicit, scope openid + profile + email. Bỏ trống cả 2 = chỉ
# dùng handoff của ERP (mục dưới) + form system_admin.
UPSTREAM_OIDC_ISSUER_URL=https://idp.hdwebsoft.co
UPSTREAM_OIDC_CLIENT_ID=hd-dochub
# Trống = public client (PKCE). Có = confidential, bridge gửi client_secret_basic.
UPSTREAM_OIDC_CLIENT_SECRET=
# Mặc định "openid profile email". Thêm "roles" khi IdP bật claim role.
UPSTREAM_OIDC_SCOPES=
# Trang đăng nhập của bridge có nút "Đăng nhập SSO" (sang IdP) + form system_admin bên dưới.

# ───────────── ERP SSO handoff (erp-fake, http://localhost:4000) ─────────────
# Tùy chọn khi đã có IdP thật ở trên: để trống CẢ ERP_SSO_JWKS_URL lẫn
# ERP_SSO_PUBLIC_KEY_PEM thì route /sso tắt. Bridge verify JWT handoff bằng
# public key của ERP. `iss`/`aud` phải khớp token.
ERP_SSO_ISSUER=erp-fake
ERP_SSO_AUDIENCE=hd-document-sso
# Thuật toán chấp nhận: ES256 và/hoặc RS256 (cách nhau dấu phẩy).
ERP_SSO_ALGORITHMS=ES256
# Nguồn khóa. Production: đặt đúng 1 trong 2.
#  - JWKS URL của ERP (container gọi ra host Windows/Mac qua host.docker.internal).
ERP_SSO_JWKS_URL=http://host.docker.internal:4000/.well-known/jwks.json
#  - PEM (SPKI, xuống dòng viết \n). Dev: khóa của CLI đóng vai ERP, sinh bằng
#    pnpm --filter @hd-document/oidc-bridge dev:generate-erp-keypair
#    Đặt cả 2 nguồn khi dev: token của CLI dùng khóa PEM, còn lại hỏi JWKS.
ERP_SSO_PUBLIC_KEY_PEM=
# Link /sso chỉ được mở từ trang ERP (chống login CSRF). Origin của ERP mà
# trình duyệt thấy, cách nhau dấu phẩy. Tắt kiểm tra: SSO_REQUIRE_REFERRER=false.
SSO_REQUIRE_REFERRER=true
SSO_ALLOWED_REFERRER_ORIGINS=http://localhost:4000
# Link "quay lại ERP" trên form đăng nhập và trang lỗi của bridge.
ERP_PORTAL_URL=http://localhost:4000
# URL public của permission API: dùng cho returnTo của /sso tới /pending/*
# (không cần khi đi qua IdP) VÀ cho redirectUris của OAuth client ở mục dưới
# (bắt buộc trước khi chạy register-outline-oauth-client).
PERMISSION_API_PUBLIC_URL=

# ───────────── Cấu hình + branding Outline (packages/outline-workspace-setup) ─────────────
# API key tạo bằng tay: đăng nhập Outline bằng system_admin → Settings → API →
# tạo key mới. Chỉ dùng cho 2 script dưới, không log, không commit.
OUTLINE_ADMIN_API_TOKEN=
# Áp bằng: pnpm --filter @hd-document/outline-workspace-setup apply-workspace-settings
WORKSPACE_NAME=HD Document
# URL logo (PNG/SVG công khai); để trống = giữ logo hiện tại, không reset.
WORKSPACE_LOGO_URL=
# Màu nhấn, hex 6 ký tự; để trống = giữ màu hiện tại.
WORKSPACE_ACCENT_COLOR=
# Điền sau khi chạy: pnpm --filter @hd-document/outline-workspace-setup register-oauth-client
# (script in ra đúng 1 lần; clientSecret không lấy lại được, phải tạo client mới nếu mất).
OUTLINE_OAUTH_CLIENT_ID=
OUTLINE_OAUTH_CLIENT_SECRET=

# ───────────── outline-permission-api ─────────────
# ERP đẩy user + quyền qua đây bằng service key (tạo bằng
# `pnpm --filter @hd-document/outline-permission-api manage-service-client`).
# Dùng chung OUTLINE_ADMIN_API_TOKEN và SYSTEM_ADMIN_EMAIL ở mục trên.
# URL service gọi Outline API; trong compose mặc định http://outline:3000 (không
# cần đặt). Chạy từ host (pnpm dev) thì để trống = dùng OUTLINE_URL.
# OUTLINE_INTERNAL_URL=
# Service key cho oidc-bridge tự tạo user ERP ở lần SSO đầu (email/tên lấy từ
# IdP). Tạo: manage-service-client create oidc-bridge --scopes users:write --project-keys "*"
# Để trống = tắt: user phải được ERP provision trước (PUT /users/{sub}).
PERMISSION_API_SERVICE_KEY=
# URL bridge gọi permission API; trong compose mặc định http://outline-permission-api:4100.
# PERMISSION_API_INTERNAL_URL=
PERMISSION_API_HOST_PORT=4100
PERMISSION_API_BIND_ADDRESS=127.0.0.1
# true khi chạy sau reverse proxy (tin X-Forwarded-For/Proto cho audit log).
PERMISSION_API_TRUST_PROXY=false


# ==========================================
# MAIL/SMTP CONFIGURATION (Outline Permission API)
# ==========================================
# Thông tin cấu hình SMTP để gửi mail tự động khi invite member vào Node
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=HD Document <no-reply@hd-document.example.com>

# ───────────── Đặt trong shell khi chạy migration / test từ host ─────────────
# APP_DATABASE_URL=postgres://hd_document_apps:<APP_DB_PASSWORD>@localhost:5432/hd_document_apps
# BRIDGE_DATABASE_URL=postgres://bridge_app:<BRIDGE_DB_PASSWORD>@localhost:5432/hd_document_apps
# PERMISSION_API_DATABASE_URL=postgres://permission_api_app:<PERMISSION_API_DB_PASSWORD>@localhost:5432/hd_document_apps
