# Copy thành tests/e2e/.env. KHÔNG commit tests/e2e/.env.
# Mật khẩu gốc của system_admin (hash của nó nằm trong infra/.env).
E2E_SYSTEM_ADMIN_USERNAME=system_admin
E2E_SYSTEM_ADMIN_PASSWORD=

# Spec tạo node (phase 5). Service key: manage-service-client create e2e-test
#   --scopes users:write,permissions:write,documents:create --project-keys "*"
# Thiếu key → các spec đó tự skip. Mặc định API ở http://localhost:<PERMISSION_API_HOST_PORT>.
E2E_PERMISSION_API_SERVICE_KEY=
# E2E_PERMISSION_API_URL=http://localhost:4100
